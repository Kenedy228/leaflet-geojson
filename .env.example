# Copy to .env and replace the placeholder. This file contains no active credentials.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gis
DB_USER=gis
DB_PASSWORD=replace-with-your-local-password
# Optional external database override for make run (make dev always uses Compose):
# DB_URL=jdbc:postgresql://localhost:5432/gis

# Optional Spring Boot port; frontend API requests use the same origin.
SERVER_PORT=8080

# Empty: same-origin UI/API, no cross-origin permissions. Optional exact origins,
# comma-separated, without paths, trailing slash, wildcard or credentials:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://viewer.example.test
CORS_ALLOWED_ORIGINS=

# Readonly by default, including demo. make init-editor opts into shared editing
# and generates a private password here; never put it in frontend or Git.
EDITING_ENABLED=false
EDITOR_USERNAME=editor
EDITOR_PASSWORD=
