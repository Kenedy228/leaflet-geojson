# Copy to .env and replace the placeholder. This file contains no active credentials.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gis
DB_USER=gis
DB_PASSWORD=replace-with-your-local-password
# Optional external database override for make run (make dev always uses Compose):
# DB_URL=jdbc:postgresql://localhost:5432/gis

# Optional Spring Boot port; frontend API requests use the same origin.
SERVER_PORT=8080
