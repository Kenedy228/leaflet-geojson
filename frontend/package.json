{
  "name": "leaflet-geojson-frontend",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "test:browser": "node --test --test-concurrency=1 tests/browser/*.test.cjs",
    "lint": "eslint .",
    "format:check": "prettier --check \"*.{js,mjs,ts,html,json}\" \"src/**/*.{ts,svelte,css}\" \"tests/**/*.cjs\"",
    "format": "prettier --write \"*.{js,mjs,ts,html,json}\" \"src/**/*.{ts,svelte,css}\" \"tests/**/*.cjs\"",
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:openapi": "node tests/contract/openapi.cjs",
    "test:contract": "node tests/contract/http.cjs"
  },
  "engines": {
    "node": "^22.23.4 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/geojson": "7946.0.16",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.24.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "svelte": "5.57.3"
  },
  "type": "module",
  "license": "MIT"
}
