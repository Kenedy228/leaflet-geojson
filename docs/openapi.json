  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID",
        "description": "HttpOnly/SameSite=Lax; вход через серверную форму /login, без Basic auth."
      },
      "csrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-TOKEN",
        "description": "Свежий токен из /api/v1/session; cross-origin credentials не поддерживаются."
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "invalid_point_batch",
              "invalid_distance_request",
              "invalid_point_id",
              "read_only_point",
              "point_not_found",
              "authentication_required",
              "forbidden",
              "invalid_csrf",
              "not_found",
              "method_not_allowed",
              "not_acceptable",
              "payload_too_large",
              "unsupported_media_type",
              "internal_error",
              "service_unavailable",
              "invalid_spatial_query",
              "spatial_limit_exceeded",
              "spatial_geometry_limit_exceeded",
              "spatial_query_timeout"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "example": {
          "code": "invalid_distance_request",
          "message": "Требуется 2–1000 пар [lng,lat]."
        }
      },
      "NewPoint": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "lat",
          "lng"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "1–255 Unicode code points, не только пробелы (String.isBlank); без NUL и непарных суррогатов.",
            "pattern": "^[^\\u0000]*$"
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "description": "WGS84; пользовательская геометрия хранится в EPSG:4326."
          },
          "lng": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        }
      },
      "Point": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "osm_id",
          "name",
          "geojson"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Непрозрачный строковый ID osm:<bigint> или user:<uuid>; не JavaScript Number."
          },
          "source": {
            "type": "string",
            "enum": [
              "osm",
              "user"
            ]
          },
          "osm_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "geojson": {
            "type": "string",
            "description": "Существующий v1 формат: JSON-строка GeoJSON Point, координаты [lng,lat]."
          }
        }
      },
      "CoordinatePair": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "description": "WGS84; пользовательская геометрия хранится в EPSG:4326."
          }
        ],
        "items": false
      },
      "CreatedPoints": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inserted",
          "points"
        ],
        "properties": {
          "inserted": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "points": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/Point"
            }
          }
        }
      },
      "DistanceRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "points"
        ],
        "properties": {
          "points": {
            "type": "array",
            "minItems": 2,
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/CoordinatePair"
            }
          }
        }
      },
      "DistanceResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lines",
          "totalDistance"
        ],
        "properties": {
          "lines": {
            "type": "array",
            "minItems": 1,
            "maxItems": 999,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to",
                "distance"
              ],
              "properties": {
                "from": {
                  "$ref": "#/components/schemas/CoordinatePair"
                },
                "to": {
                  "$ref": "#/components/schemas/CoordinatePair"
                },
                "distance": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "totalDistance": {
            "type": "number",
            "minimum": 0,
            "description": "Legacy v1 camelCase, сохранён для совместимости."
          }
        }
      },
      "Road": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "osm_id",
          "name",
          "highway",
          "geojson"
        ],
        "properties": {
          "osm_id": {
            "type": "integer",
            "format": "int64",
            "description": "Legacy reference ID, may exceed JavaScript Number precision. The UI does not convert it into point identity."
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "geojson": {
            "type": "string",
            "description": "GeoJSON geometry encoded as JSON string; WGS84 [lng,lat]. Clipped and simplified for display using bbox/zoom."
          },
          "highway": {
            "type": "string"
          }
        }
      },
      "Polygon": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "osm_id",
          "name",
          "leisure_type",
          "landuse_type",
          "geojson"
        ],
        "properties": {
          "osm_id": {
            "type": "integer",
            "format": "int64",
            "description": "Legacy reference ID, may exceed JavaScript Number precision. The UI does not convert it into point identity."
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "geojson": {
            "type": "string",
            "description": "GeoJSON geometry encoded as JSON string; WGS84 [lng,lat]. Clipped and simplified for display using bbox/zoom."
          },
          "leisure_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "landuse_type": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "UP",
              "DOWN",
              "OUT_OF_SERVICE",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    "parameters": {
      "Bbox": {
        "name": "bbox",
        "in": "query",
        "required": false,
        "description": "WGS84 west,south,east,north: четыре конечных десятичных числа (exponent допустим), долготы [-180,180], широты [-90,90], south<north. west>east пересекает антимеридиан; нулевая ширина, включая 180→-180, недопустима. Повторение bbox даёт 400. Без bbox — весь мир с теми же лимитами, не безлимитный экспорт.",
        "schema": {
          "type": "string",
          "default": "-180,-90,180,90"
        },
        "example": "35.3,52.3,35.4,52.4"
      },
      "MapZoom": {
        "name": "zoom",
        "in": "query",
        "required": false,
        "description": "Целое 0..22; повторение/неверный формат даёт 400. Влияет только на display-детализацию reference-геометрии; координаты точек и distance не упрощаются.",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "maximum": 22,
          "default": 22
        }
      }
    },
    "headers": {
      "RequestId": {
        "description": "Сгенерированный сервером UUID; тот же request_id в безопасном журнале. Входной X-Request-ID игнорируется.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
