    "/api/v1/session": {
      "get": {
        "summary": "Текущее состояние прав и свежий сессионный CSRF",
        "security": [],
        "description": "Cache-Control: no-store. Получать после login/logout; старый CSRF после входа не действует. Пароль и session cookie в тело не включаются.",
        "responses": {
          "200": {
            "description": "Текущая сессия",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "editing_enabled",
                    "can_edit",
                    "csrf_header",
                    "csrf_token"
                  ],
                  "properties": {
                    "editing_enabled": {
                      "type": "boolean"
                    },
                    "can_edit": {
                      "type": "boolean"
                    },
                    "csrf_header": {
                      "type": "string",
                      "const": "X-CSRF-TOKEN"
                    },
                    "csrf_token": {
                      "type": "string"
