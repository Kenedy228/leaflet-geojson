          "200": {
            "description": "Complete bounded display layer; no success envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "maxItems": 500,
                  "items": {
                    "$ref": "#/components/schemas/Point"
                  }
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "403": {
            "description": "Safe code/message JSON. No SQL, exception text or credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "500": {
            "description": "Safe code/message JSON. No SQL, exception text or credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "503": {
            "description": "spatial_query_timeout после 2 с бюджета либо service_unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "400": {
            "description": "invalid_spatial_query: некорректный, пустой, повторяющийся или nonfinite bbox/zoom.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "406": {
            "description": "Safe code/message JSON. No SQL, exception text or credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "413": {
            "description": "spatial_limit_exceeded (>500 объектов) или spatial_geometry_limit_exceeded (>5000 вершин/объект либо>20000/слой). Сузить bbox/приблизить карту; частичного успеха нет.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Bbox"
          },
          {
            "$ref": "#/components/parameters/MapZoom"
          }
        ],
        "description": "Полный подходящий набор только при≤500 source-объектов в bbox. При превышении 413 spatial_limit_exceeded, без частичного успеха. GiST/точный spatial predicate в CRS хранения до GeoJSON. Бюджет SQL2 с; timeout503 spatial_query_timeout. Общий лимит для именованных OSM-точек 3857 и пользовательских 4326. Точки остаются точными, userpoints включают допустимые полюса; OSM bbox обрезается по±85.0511287798066."
      }
    },
